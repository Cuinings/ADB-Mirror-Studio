<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdbMirrorStudio.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True" OpenPaneLength="220" CompactPaneLength="48"
                    CompactModeThresholdWidth="720" ExpandedModeThresholdWidth="1180"
                    Background="Transparent" SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="设备中心" Tag="devices" IsSelected="True">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="镜像会话" Tag="sessions">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE714;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="文件与 APK" Tag="files">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="设备工具" Tag="tools">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="诊断中心" Tag="diagnostics">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="关于" Tag="about">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <Grid x:Name="DeviceCenterView" Margin="24,20,24,20" MaxWidth="1200" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="设备中心" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="连接 Android 设备并管理实时镜像会话" Opacity="0.68" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressRing Width="22" Height="22" IsActive="{Binding IsBusy}" />
                        <Button Content="刷新设备" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,22,0,16" Spacing="10">
                <Border Padding="18" CornerRadius="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE839;" FontSize="20" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Header="无线地址"
                                  ItemsSource="{Binding RememberedEndpoints}"
                                  Text="{Binding Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" PlaceholderText="输入地址或选择历史记录" />
                        <Button Grid.Column="2" Content="连接设备" VerticalAlignment="Bottom" Click="Connect_Click"
                                IsEnabled="{Binding IsIdle}" Style="{ThemeResource AccentButtonStyle}" />
                        <Button Grid.Column="3" Content="清除记录" VerticalAlignment="Bottom" Click="ClearHistory_Click"
                                IsEnabled="{Binding HasRememberedEndpoints}" />
                    </Grid>
                </Border>

                <Expander Header="Android 11+ 安全无线配对" IsExpanded="False">
                    <Grid Padding="0,12,0,2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding DiscoveredPairingEndpoints}" Text="{Binding PairEndpoint, Mode=TwoWay}"
                                  IsEditable="True" PlaceholderText="IP:配对端口" />
                        <PasswordBox x:Name="PairingCodeBox" Grid.Column="1" PlaceholderText="六位配对码"
                                     PasswordChanged="PairingCodeBox_PasswordChanged" />
                        <Button Grid.Column="2" Content="配对" Click="Pair_Click" IsEnabled="{Binding IsIdle}"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </Grid>
                </Expander>
                <Expander Header="镜像质量与录屏" IsExpanded="False">
                    <Grid Padding="0,12,0,2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="MirrorProfileSelector" Header="质量预设"
                                  ItemsSource="{Binding MirrorProfiles}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedMirrorProfileId, Mode=TwoWay}"
                                  SelectionChanged="MirrorProfileSelector_SelectionChanged" />
                        <TextBox Grid.Column="1" Header="录屏文件（可选）" Text="{Binding RecordingPath}"
                                 IsReadOnly="True" PlaceholderText="不录制" />
                        <Button Grid.Column="2" Content="选择位置" Click="ChooseRecordingPath_Click" VerticalAlignment="Bottom" />
                        <Button Grid.Column="3" Content="清除" Click="ClearRecordingPath_Click" VerticalAlignment="Bottom" />
                    </Grid>
                </Expander>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,4,0,10">
                    <TextBlock Text="已发现设备" FontSize="18" FontWeight="SemiBold" />
                    <Border HorizontalAlignment="Right" Padding="10,4" CornerRadius="10"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}">
                        <TextBlock Text="{Binding OnlineSummary}" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <ListView ItemsSource="{Binding Devices}" SelectionMode="None" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12"
                                                Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                            <FontIcon Glyph="&#xE8EA;" FontSize="21" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock Text="{Binding Serial}" Opacity="0.62" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Padding="8,3" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding ConnectionLabel}" />
                                            </Border>
                                            <Border Padding="8,3" CornerRadius="8" Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                                <TextBlock Text="{Binding StateLabel}" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="{Binding MirrorButtonText}" IsEnabled="{Binding IsOnline}"
                                                CommandParameter="{Binding Serial}" Click="Mirror_Click"
                                                Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" />
                                        <CommandBar Grid.Column="4" Margin="8,0,0,0" Background="Transparent"
                                                    DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                                            <AppBarButton Label="TCP/IP" CommandParameter="{Binding Serial}" Click="EnableTcpIp_Click" />
                                            <AppBarButton Label="重启" CommandParameter="{Binding Serial}" Click="Reboot_Click" />
                                            <AppBarButton Label="断开" CommandParameter="{Binding Serial}" Click="Disconnect_Click" />
                                        </CommandBar>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>

                <Border Grid.Row="4" Margin="0,14,0,0" Padding="12,8" CornerRadius="10"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Grid x:Name="SessionsView" Margin="24,20" MaxWidth="1200" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="镜像会话" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="查看采集参数、管理录制并排列多个 scrcpy 窗口" Opacity="0.68" />
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                        <AppBarButton Label="宫格排列" Tag="grid" Click="ArrangeWindows_Click" />
                        <AppBarButton Label="横向排列" Tag="horizontal" Click="ArrangeWindows_Click" />
                        <AppBarButton Label="纵向排列" Tag="vertical" Click="ArrangeWindows_Click" />
                    </CommandBar>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                <ListView ItemsSource="{Binding Sessions}" MaxHeight="420"
                          SelectionMode="None" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE714;" FontSize="22" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding DeviceSerial}" FontWeight="SemiBold" FontFamily="Consolas" />
                                        <TextBlock Text="{Binding StartedAtLabel}" Opacity="0.62" />
                                        <TextBlock Text="{Binding PerformanceLabel}" Opacity="0.72" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding RecordingLabel}" Opacity="0.62" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="9,4" CornerRadius="9"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateLabel}" />
                                    </Border>
                                    <StackPanel Grid.Column="3" Margin="8,0,0,0" Orientation="Horizontal" Spacing="8">
                                        <Button Content="{Binding RecordingButtonText}"
                                                CommandParameter="{Binding DeviceSerial}" Click="ToggleSessionRecording_Click" />
                                        <Button Content="停止镜像"
                                                CommandParameter="{Binding DeviceSerial}" Click="StopMirror_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                    <Border Padding="18" CornerRadius="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                        <TextBlock Text="录制中心" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="可在上方运行中的镜像会话直接开始或停止录制。切换时会自动保存窗口位置并快速重启一次镜像，以确保录像文件正常封装。"
                                   TextWrapping="Wrap" Opacity="0.66" />
                        <ListView ItemsSource="{Binding Recordings}" MaxHeight="220" SelectionMode="None" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Opacity="0.62" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="1" MaxWidth="360" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding SizeLabel}" Opacity="0.62"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DeviceSerial}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                        <Button Grid.Column="3" Content="打开目录" CommandParameter="{Binding Path}" Click="OpenRecordingDirectory_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Padding="12,8" CornerRadius="10"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Grid x:Name="DiagnosticsView" Margin="24,20" MaxWidth="1200" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="诊断中心" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="检查 ADB、scrcpy、mDNS 与潜在版本冲突" Opacity="0.68" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="运行诊断" Click="RunDiagnostics_Click"
                            IsEnabled="{Binding IsIdle}" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" />
                </Grid>
                <ListView Grid.Row="1" Margin="0,22,0,0" ItemsSource="{Binding Diagnostics}"
                          SelectionMode="None" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Opacity="0.68" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StateLabel}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" Padding="12,8" CornerRadius="10"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Grid x:Name="FilesView" Margin="24,20" MaxWidth="1000" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="文件与 APK" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="安装 Android 应用，或将文件安全推送到设备的 Download 目录" Opacity="0.68" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,22,0,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Border Padding="18" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="目标设备" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="仅可对已连接且已授权的设备执行操作" Opacity="0.62" />
                                </StackPanel>
                                <ComboBox x:Name="TransferDeviceSelector" ItemsSource="{Binding Devices}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="Serial"
                                          SelectedValue="{Binding SelectedTransferDeviceSerial, Mode=TwoWay}"
                                          PlaceholderText="选择目标设备" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <Border Padding="18" CornerRadius="14" AllowDrop="True"
                                DragOver="FileDrop_DragOver" Drop="FileDrop_Drop"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="本地文件" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="支持多选和拖放；路径包含空格或中文也可安全传输" Opacity="0.62" />
                                </StackPanel>
                                 <TextBox Text="{Binding TransferFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="请选择 APK 或任意本地文件" IsReadOnly="True" />
                                <ListView ItemsSource="{Binding TransferQueue}" MaxHeight="150" SelectionMode="None"
                                          Background="Transparent">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="10" Padding="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Opacity="0.62" />
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CommandBar Background="Transparent" DefaultLabelPosition="Right"
                                                IsDynamicOverflowEnabled="True">
                                        <AppBarButton Label="选择 APK" Click="ChooseApk_Click" IsEnabled="{Binding IsIdle}" />
                                        <AppBarButton Label="安装 APK" Click="InstallApk_Click" IsEnabled="{Binding IsIdle}" />
                                        <AppBarButton Label="选择文件" Click="ChooseFile_Click" IsEnabled="{Binding IsIdle}" />
                                        <AppBarButton Label="推送到 Download" Click="PushFile_Click" IsEnabled="{Binding IsIdle}" />
                                        <AppBarButton Label="取消传输" Click="CancelTransfer_Click"
                                                      IsEnabled="{Binding IsTransferRunning}" />
                                    </CommandBar>
                                    <ProgressRing Grid.Column="1" Width="22" Height="22" IsActive="{Binding IsBusy}"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                         Title="覆盖规则"
                                         Message="安装 APK 使用 -r 保留应用数据；同名文件推送时由 ADB 覆盖目标文件。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="12,8" CornerRadius="10"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Grid x:Name="ToolsView" Margin="24,20" MaxWidth="1000" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="设备工具" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="查看设备状态、保存截图、导出日志并从设备下载文件" Opacity="0.68" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,22,0,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Border Padding="18" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="目标设备" FontSize="17" FontWeight="SemiBold" />
                                <ComboBox x:Name="ToolsDeviceSelector" ItemsSource="{Binding Devices}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="Serial"
                                          SelectedValue="{Binding SelectedToolsDeviceSerial, Mode=TwoWay}"
                                          PlaceholderText="选择已连接设备" HorizontalAlignment="Stretch" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CommandBar Background="Transparent" DefaultLabelPosition="Right"
                                                IsDynamicOverflowEnabled="True">
                                        <AppBarButton Label="设备详情" Click="DeviceDetails_Click" IsEnabled="{Binding IsIdle}" />
                                        <AppBarButton Label="保存截图" Click="SaveScreenshot_Click" IsEnabled="{Binding IsIdle}" />
                                        <AppBarButton Label="导出 Logcat" Click="ExportLogcat_Click" IsEnabled="{Binding IsIdle}" />
                                    </CommandBar>
                                    <ProgressRing Grid.Column="1" Width="22" Height="22" IsActive="{Binding IsBusy}"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="18" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="设备快捷控制" FontSize="17" FontWeight="SemiBold" />
                                <CommandBar Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                                    <AppBarButton Label="返回" Tag="4" Click="DeviceKey_Click" />
                                    <AppBarButton Label="主页" Tag="3" Click="DeviceKey_Click" />
                                    <AppBarButton Label="最近任务" Tag="187" Click="DeviceKey_Click" />
                                    <AppBarButton Label="电源" Tag="26" Click="DeviceKey_Click" />
                                    <AppBarButton Label="音量+" Tag="24" Click="DeviceKey_Click" />
                                    <AppBarButton Label="音量-" Tag="25" Click="DeviceKey_Click" />
                                </CommandBar>
                            </StackPanel>
                        </Border>

                        <Border Padding="18" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="应用管理器" FontSize="17" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding InstalledApps}" DisplayMemberPath="PackageName" SelectedValuePath="PackageName"
                                              SelectedValue="{Binding SelectedAppPackage, Mode=TwoWay}" PlaceholderText="先读取设备应用" />
                                    <Button Grid.Column="1" Content="读取用户应用" Click="RefreshApps_Click" />
                                </Grid>
                                <CommandBar Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                                    <AppBarButton Label="启动" Tag="launch" Click="AppAction_Click" IsEnabled="{Binding IsIdle}" />
                                    <AppBarButton Label="强制停止" Tag="stop" Click="AppAction_Click" IsEnabled="{Binding IsIdle}" />
                                    <AppBarButton Label="卸载" Tag="uninstall" Click="AppAction_Click" IsEnabled="{Binding IsIdle}" />
                                </CommandBar>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="按包名卸载" Text="{Binding PackageNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="例如 com.example.app" />
                                    <Button Grid.Column="1" Content="卸载指定包名" Click="UninstallPackage_Click"
                                            IsEnabled="{Binding IsIdle}" VerticalAlignment="Bottom" />
                                </Grid>
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="卸载提示"
                                         Message="可以从列表选择或直接输入包名。卸载会删除该应用及其设备数据，执行前会再次确认。" />
                            </StackPanel>
                        </Border>

                        <Border Padding="18" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="ADB Shell（高级）" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="命令只发送到上方选中的 Android 设备，不调用 Windows cmd.exe，也不会保存命令历史。"
                                               TextWrapping="Wrap" Opacity="0.62" />
                                </StackPanel>
                                <TextBox Header="设备命令" Text="{Binding ShellCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="例如 getprop ro.product.model" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="在选中设备执行" Click="RunShellCommand_Click"
                                            IsEnabled="{Binding IsIdle}" Style="{ThemeResource AccentButtonStyle}" />
                                    <Button Content="取消" Click="CancelShellCommand_Click"
                                            IsEnabled="{Binding IsShellCommandRunning}" />
                                    <Button Content="清除输出" Click="ClearShellOutput_Click" />
                                </StackPanel>
                                <TextBox Text="{Binding ShellOutput}" IsReadOnly="True" AcceptsReturn="True"
                                         FontFamily="Consolas" MinHeight="160" MaxHeight="300"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="高级操作"
                                         Message="命令由设备端 sh 解释，可能修改或删除设备数据。请确认目标设备和命令内容后再执行。" />
                            </StackPanel>
                        </Border>

                        <Border Padding="18" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="从设备下载" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="输入设备上的绝对路径，可下载单个文件或目录" Opacity="0.62" />
                                </StackPanel>
                                <TextBox Header="设备路径" Text="{Binding RemoteFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="/sdcard/Download/example.zip" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="保存到本地目录" Text="{Binding LocalDownloadDirectory}"
                                             IsReadOnly="True" PlaceholderText="请选择本地目录" />
                                    <Button Grid.Column="1" Content="选择目录" Click="ChooseDownloadDirectory_Click"
                                            VerticalAlignment="Bottom" />
                                </Grid>
                                <Button Content="开始下载" Click="PullRemoteFile_Click"
                                        IsEnabled="{Binding IsIdle}" Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Left" />
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                         Title="路径说明"
                                         Message="设备路径必须以 / 开头；下载目录为空时不会执行操作。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="12,8" CornerRadius="10"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Grid x:Name="AboutView" Margin="24,20" MaxWidth="900" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="关于 ADB Mirror Studio" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Android 设备连接、镜像、文件与诊断工作台" Opacity="0.68" />
                        </StackPanel>
                        <Border Padding="18" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="48" Height="48"
                                       VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="ADB Mirror Studio" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock><Run Text="版本 "/><Run Text="{Binding AppVersion}" /></TextBlock>
                                    <TextBlock Text="基于 WinUI 3、Android Debug Bridge 与 scrcpy" Opacity="0.62" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Padding="18" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="隐私与数据" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="应用不内置遥测或广告 SDK。设置及崩溃日志保存在以下本地目录，可随时查看或删除。"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DataDirectory}" FontFamily="Consolas" Opacity="0.72" />
                                <Button Content="打开数据目录" Click="OpenDataDirectory_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Padding="18" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="免费更新" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="仅访问公开 GitHub Release，不上传设备或用户数据。安装前会校验文件大小和 SHA256。"
                                           TextWrapping="Wrap" Opacity="0.68" />
                                <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="Wrap" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateDownloadProgress}"
                                             Height="4" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="检查更新" Click="CheckUpdates_Click" IsEnabled="{Binding IsIdle}" />
                                    <Button Content="下载并安装" Click="DownloadAndInstallUpdate_Click"
                                            IsEnabled="{Binding CanDownloadAndInstallUpdate}"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                    <Button Content="取消下载" Click="CancelUpdateDownload_Click"
                                            IsEnabled="{Binding IsUpdateDownloading}" />
                                    <Button Content="打开发布页面" Click="OpenUpdate_Click" />
                                    <ProgressRing Width="22" Height="22" IsActive="{Binding IsBusy}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="第三方组件"
                                 Message="ADB 与 scrcpy 使用 Apache-2.0；SDL、FFmpeg、libusb 的许可与归属文件随发布包提供。" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="SettingsView" Margin="24,20" MaxWidth="900" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="外观与设备刷新偏好" Opacity="0.68" />
                    </StackPanel>
                    <Border Padding="18" CornerRadius="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="应用主题" FontSize="17" FontWeight="SemiBold" />
                            <RadioButtons x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeSelector_SelectionChanged">
                                <x:String>跟随系统</x:String>
                                <x:String>浅色</x:String>
                                <x:String>深色</x:String>
                            </RadioButtons>
                        </StackPanel>
                    </Border>
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="连接历史"
                             Message="成功连接过的无线地址仅保存在本机，启动时不会自动重连；请在设备中心手动选择并连接。" />
                    <Border Padding="18" CornerRadius="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="自动刷新设备" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="每 5 秒更新设备状态；执行安装、传输或诊断时会自动避让" Opacity="0.62" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoRefreshToggle" Grid.Column="1"
                                          OnContent="开启" OffContent="关闭"
                                          Toggled="AutoRefreshToggle_Toggled" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Text="设置保存在本机，重新安装便携包不会覆盖已有偏好。" Opacity="0.62" />
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
