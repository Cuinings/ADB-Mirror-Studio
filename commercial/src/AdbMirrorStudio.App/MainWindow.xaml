<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AdbMirrorStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ADB Mirror Studio">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" Background="Transparent" ActualThemeChanged="RootLayout_ActualThemeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <Grid Margin="16,0,0,0" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center"
                  ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                       Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <TranslateTransform Y="2" />
                    </Image.RenderTransform>
                </Image>
                <TextBlock Grid.Column="1" Text="ADB Mirror Studio" FontSize="14" FontWeight="SemiBold"
                           LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
                <Border Grid.Column="2" MinWidth="56" Height="28" Padding="10,0" CornerRadius="9"
                        VerticalAlignment="Center" Background="{ThemeResource AccentFillColorTertiaryBrush}">
                    <TextBlock x:Name="VersionText" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
        <Frame x:Name="RootFrame" Grid.Row="1" Background="Transparent" />
    </Grid>
</Window>
