<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AdbMirrorStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ADB Mirror Studio">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" Background="Transparent" ActualThemeChanged="RootLayout_ActualThemeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Image Source="Assets/Square44x44Logo.scale-200.png" Width="22" Height="22" />
                <TextBlock Text="ADB Mirror Studio" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Padding="8,2" CornerRadius="8" Background="{ThemeResource AccentFillColorTertiaryBrush}">
                    <TextBlock Text="V1.0.0" FontSize="10" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Grid>
        <Frame x:Name="RootFrame" Grid.Row="1" Background="Transparent" />
    </Grid>
</Window>
